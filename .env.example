# Tracksolid Pro credentials
TRACKSOLID_APP_KEY=your-app-key
TRACKSOLID_APP_SECRET=your-app-secret
TRACKSOLID_USER_ID=your-account-id
TRACKSOLID_USER_PWD_MD5=md5-hash-of-your-password

# Paths (optional)
# TRACKSOLID_TEMPLATE_PATH=/absolute/path/to/Trip review template.xlsx
# TRACKSOLID_OUTPUT_DIR=/absolute/path/to/reports

# Flask
FLASK_SECRET=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Supabase — from Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...