# Tracksolid Pro credentials
TRACKSOLID_APP_KEY=your-app-key
TRACKSOLID_APP_SECRET=your-app-secret
TRACKSOLID_USER_ID=your-account-id
TRACKSOLID_USER_PWD_MD5=md5-hash-of-your-password

# Paths (optional)
# TRACKSOLID_TEMPLATE_PATH=/absolute/path/to/Trip review template.xlsx
# TRACKSOLID_OUTPUT_DIR=/absolute/path/to/reports

# Flask
FLASK_SECRET=change-me-to-a-long-random-string
FLASK_DEBUG=0

# Supabase — from Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Tracksolid IPs (informational, do NOT put these in .env) ─────────
# These are the IPs of Tracksolid's servers. Only relevant if you put
# an IP allowlist on *your* firewall — they let Tracksolid reach you.
#   mx2: 101.44.26.189
#   dbl: 101.46.140.34
#   sg:  190.92.199.65
#
# If Tracksolid ever enables allowlisting on *their* side (firewall that
# only accepts traffic from certain source IPs), give them the outbound
# IPs of whichever host runs your app:
#   Render → see https://render.com/docs/outbound-ip-addresses
#   On-prem → your company's public NAT IP